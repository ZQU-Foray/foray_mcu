{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "arm-base",
      "hidden": true,
      "inherits": "base",
      "description": "固件：bringup_dm_mc02 profile（框架验证，DM-MC02）。Arm GNU 工具链取自 ARM_GCC_ROOT 或 PATH；本机路径写在 CMakeUserPresets.json（不入库）",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-gcc-cortex-m7.cmake",
      "cacheVariables": {
        "PROFILE": "bringup_dm_mc02"
      }
    },
    {
      "name": "arm-debug",
      "inherits": "arm-base",
      "displayName": "固件 Debug（bringup × DM-MC02）",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "arm-release",
      "inherits": "arm-base",
      "displayName": "固件 Release（bringup × DM-MC02）",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-tests",
      "inherits": "base",
      "displayName": "宿主测试（框架 + platform/mock）",
      "description": "本机 GCC 或 Clang；Windows 上可在 CMakeUserPresets.json 中指定 MSYS2 的编译器",
      "toolchainFile": "${sourceDir}/cmake/toolchains/host.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-sim",
      "inherits": "base",
      "displayName": "宿主下位机（firmware_sim：app/pc_link + platform/host_sim）",
      "description": "本机 GCC 或 Clang；不上板、不建宿主测试，产物 firmware_sim 走 virtual_cdc.py 的 PTY",
      "toolchainFile": "${sourceDir}/cmake/toolchains/host.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HOST_SIM": "ON"
      }
    },
    {
      "name": "framework",
      "inherits": "base",
      "displayName": "框架独立构建（src + platform/mock，宿主）",
      "description": "只配置框架，不含 app/、config/、test/host 与板卡；CI 在只含框架文件的副本里构建（规则 2、15）",
      "toolchainFile": "${sourceDir}/cmake/toolchains/host.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FRAMEWORK_ONLY": "ON"
      }
    },
    {
      "name": "framework-m0plus",
      "inherits": "base",
      "displayName": "框架独立构建（src，Cortex-M0+）",
      "description": "框架为没有原子读改写指令的 Cortex-M0+ 编译，配合 arch_check.py atomics 检查规则 13；Arm GNU 工具链同 arm-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-gcc-cortex-m0plus.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FRAMEWORK_ONLY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "arm-debug",
      "configurePreset": "arm-debug"
    },
    {
      "name": "arm-release",
      "configurePreset": "arm-release"
    },
    {
      "name": "host-tests",
      "configurePreset": "host-tests"
    },
    {
      "name": "framework",
      "configurePreset": "framework"
    },
    {
      "name": "framework-m0plus",
      "configurePreset": "framework-m0plus"
    }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
